[Unit]
Description=Hexe Supervisor (Standalone Addon Orchestrator)
After=network.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@/backend
# Where standalone services live (sibling folder to the Core repo)
Environment=HEXE_ADDONS_DIR=%h/Projects/HexeAddons
Environment=HEXE_CATALOG_PUBLISHERS=@INSTALL_DIR@/runtime/store/cache/official/publishers.json
Environment=HEXE_SUPERVISOR_INTERVAL_S=5
Environment=PYTHONUNBUFFERED=1

ExecStart=@INSTALL_DIR@/backend/.venv/bin/python -m hexe_supervisor.main

Restart=always
RestartSec=2
EnvironmentFile=-%h/.config/hexe/admin.env
EnvironmentFile=-%h/.config/hexe/supervisor.env

[Install]
WantedBy=default.target
