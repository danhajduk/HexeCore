{
  "$id": "https://hexe.local/schemas/ble_onboarding_provisioning.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hexe BLE Onboarding Provisioning Schemas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gatt_contract_version",
    "envelope_schema_version",
    "operation",
    "encryption_model",
    "service",
    "core_published_pairing_session_schema",
    "payload_schemas",
    "provisioning_envelope_schema"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "gatt_contract_version": {
      "const": "1.0"
    },
    "envelope_schema_version": {
      "const": "1.0"
    },
    "operation": {
      "const": "ble.provision_wifi"
    },
    "encryption_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_agreement",
        "algorithm",
        "endpoint_public_key",
        "supervisor_public_key",
        "replay_protection"
      ],
      "properties": {
        "key_agreement": {
          "const": "x25519-hkdf-sha256"
        },
        "algorithm": {
          "const": "aes-256-gcm"
        },
        "endpoint_public_key": {
          "const": "endpoint_ephemeral_public_key"
        },
        "supervisor_public_key": {
          "const": "supervisor_ephemeral_public_key"
        },
        "replay_protection": {
          "type": "array",
          "prefixItems": [
            {
              "const": "sequence"
            },
            {
              "const": "expires_at"
            }
          ],
          "items": false
        }
      }
    },
    "service": {
      "$ref": "#/$defs/gatt_service"
    },
    "core_published_pairing_session_schema": {
      "$ref": "#/$defs/core_published_pairing_session_schema"
    },
    "payload_schemas": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node_profile_payload_schema"
      },
      "required": [
        "voice"
      ]
    },
    "provisioning_envelope_schema": {
      "$ref": "#/$defs/provisioning_envelope_schema"
    }
  },
  "$defs": {
    "gatt_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_uuid",
        "characteristics"
      ],
      "properties": {
        "service_uuid": {
          "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100000"
        },
        "characteristics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_identity",
            "pairing_nonce",
            "provisioning_status",
            "encrypted_credentials",
            "ack_error"
          ],
          "properties": {
            "device_identity": {
              "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100001"
            },
            "pairing_nonce": {
              "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100002"
            },
            "provisioning_status": {
              "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100003"
            },
            "encrypted_credentials": {
              "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100004"
            },
            "ack_error": {
              "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100005"
            }
          }
        }
      }
    },
    "node_profile_payload_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_id",
        "json_schema"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "json_schema": {
          "type": "object"
        }
      }
    },
    "core_published_pairing_session_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "service_uuid",
        "advertisement_schema",
        "pairing_offer_schema",
        "endpoint_identity_schema",
        "wifi_handoff_required_fields"
      ],
      "properties": {
        "schema_id": {
          "const": "hexe.ble_onboarding.core_published_pairing.v1"
        },
        "service_uuid": {
          "const": "7f9c0000-5f04-4d8b-9a46-7c0f7a100000"
        },
        "advertisement_schema": {
          "$ref": "#/$defs/host_pairing_advertisement"
        },
        "pairing_offer_schema": {
          "$ref": "#/$defs/host_pairing_offer"
        },
        "endpoint_identity_schema": {
          "$ref": "#/$defs/endpoint_identity_write"
        },
        "wifi_handoff_required_fields": {
          "type": "array",
          "prefixItems": [
            {
              "const": "onboarding_session_id"
            },
            {
              "const": "device_id"
            }
          ],
          "items": false
        }
      }
    },
    "host_pairing_advertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "session_role",
        "session_hint"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "session_role": {
          "const": "host_pairing_advert"
        },
        "session_hint": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "capability_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "host_pairing_offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "onboarding_session_id",
        "session_role",
        "session_hint",
        "supervisor_id",
        "expires_at",
        "requested_profile",
        "payload_schema_id",
        "claim_code_required"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "onboarding_session_id": {
          "type": "string",
          "minLength": 1
        },
        "session_role": {
          "const": "host_pairing_advert"
        },
        "session_hint": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "supervisor_id": {
          "type": "string",
          "minLength": 1
        },
        "core_id": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "requested_profile": {
          "const": "voice"
        },
        "payload_schema_id": {
          "const": "hexe.voice_node.wifi_backend.v1"
        },
        "claim_code_required": {
          "type": "boolean"
        }
      }
    },
    "endpoint_identity_write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "onboarding_session_id",
        "device_id",
        "node_hardware_id",
        "target_node_id",
        "board_profile",
        "firmware_version",
        "application_type",
        "provisioning_mode",
        "endpoint_ephemeral_public_key",
        "supported_payload_schemas",
        "provisioning_state"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "onboarding_session_id": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "node_hardware_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "board_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "firmware_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "application_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "provisioning_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "endpoint_ephemeral_public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128
        },
        "supported_payload_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provisioning_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "provisioning_envelope_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "json_schema"
      ],
      "properties": {
        "schema_id": {
          "const": "hexe.ble_onboarding.provisioning_envelope.v1"
        },
        "json_schema": {
          "$ref": "#/$defs/provisioning_envelope"
        }
      }
    },
    "provisioning_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "payload_schema_id",
        "contract_version",
        "onboarding_session_id",
        "target_node_id",
        "pairing_nonce",
        "sequence",
        "expires_at",
        "algorithm",
        "key_agreement",
        "key_id",
        "supervisor_ephemeral_public_key",
        "nonce",
        "aad",
        "ciphertext",
        "tag"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "payload_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "const": "1.0"
        },
        "onboarding_session_id": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1
        },
        "pairing_nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "algorithm": {
          "const": "aes-256-gcm"
        },
        "key_agreement": {
          "const": "x25519-hkdf-sha256"
        },
        "key_id": {
          "type": "string",
          "minLength": 16
        },
        "supervisor_ephemeral_public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "aad": {
          "type": "string",
          "minLength": 16
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "voice_wifi_backend_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wifi_ssid",
        "backend_host",
        "http_port",
        "ws_port",
        "use_tls"
      ],
      "properties": {
        "wifi_ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "wifi_password": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 8,
          "maxLength": 63
        },
        "backend_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "http_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ws_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "use_tls": {
          "type": "boolean",
          "default": true
        },
        "endpoint_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
